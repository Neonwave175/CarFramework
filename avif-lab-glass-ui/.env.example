# Required only for the dashboard's separate authenticated WebSocket device API.
ROBOT_DEVICE_TOKEN=replace-with-a-long-random-secret

# Set to 1 when the dashboard is served over HTTPS. Keep 0 only for local trusted-LAN development.
AVIF_COOKIE_SECURE=0

# Optional SQLite database path.
# AVIF_DB_PATH=./data/avif_lab.sqlite3
