# Optional: shared token for the CarFramework receiver's signed metrics side-channel.
# Generate one long random value and configure the SAME value on the dashboard host
# and the Raspberry Pi running reciever.py. This is separate from ML-DSA key files.
CARFRAMEWORK_METRICS_TOKEN=replace-with-a-long-random-secret
CARFRAMEWORK_METRICS_BIND=0.0.0.0
CARFRAMEWORK_METRICS_PORT=5007

# Path to the CarFramework checkout containing sender.py, reciever.py, encryption.py.
# Defaults to the parent directory of this UI folder.
# CARFRAMEWORK_ROOT=..

# Required only for the dashboard's separate authenticated WebSocket device API.
ROBOT_DEVICE_TOKEN=replace-with-a-long-random-secret

# Set to 1 when the dashboard is served over HTTPS. Keep 0 only for local trusted-LAN development.
AVIF_COOKIE_SECURE=0

# Optional SQLite database path.
# AVIF_DB_PATH=./data/avif_lab.sqlite3
